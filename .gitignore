# DDEV
.ddev/

# IDE
.vscode/
.idea/
*.code-workspace

# OS
.DS_Store
Thumbs.db

# DevContainer
.devcontainer/

# Env
.env
# Docker4Drupal: contiene solo tag delle immagini e valori non segreti, ed è la
# sorgente di verità dei deploy stage/prod (compose.yml lo usa come env_file del
# backend) → versionato. Le credenziali vere stanno nel .env della root.
!backend/.env

# Backup
backup/*
!backup/.gitkeep

# GitHub App private key
backend/private/

# Playwright CLI (stato/sessione browser)
.playwright-cli/

# Versione deploy (generata dai workflow CI, letta dallo status report Drupal)
backend/.deploy-version

# Hash dei file di config nginx dell'ultimo deploy (vedi cmd_build_frontend
# in ildeposito.sh): rileva se serve un force-recreate di frontend-web.
.nginx-conf.hash
# Hash del Dockerfile dell'immagine nginx locale (vedi ensure_nginx_image in
# ildeposito.sh): se cambia, l'immagine va ricostruita sul server.
.nginx-image.hash

# Stato effimero dell'aggiornamento automatico Drupal sul runner stage.
.backend-update-modules
.backend-update-outdated.json

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
