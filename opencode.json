{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": "ask",
    "bash": {
      "*": "ask",
      "graft*": "allow",
      "rtk *": "allow",
      "ddev*": "allow",
      "git": "allow",
      "git *": "allow",
      "ls": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "uname": "allow",
      "uname *": "allow",
      "date": "allow",
      "which *": "allow",
      "command -v *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "local.sh*": "allow",
      "./local.sh*": "allow",
      "bash local.sh*": "allow",
      "ildeposito.sh*": "allow",
      "./ildeposito.sh*": "allow",
      "git commit*": "deny",
      "git push*": "deny",
      "* git commit*": "deny",
      "* git push*": "deny"
    }
  }
}