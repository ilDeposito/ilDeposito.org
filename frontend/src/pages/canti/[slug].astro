---
import CantoDetailView from '../../components/detail/CantoDetailView.astro';
import { getAllCantiDetail, getEventiForCantoMap, getAutore } from '../../lib/api/index.js';
import { buildRelatedForCanto } from '../../lib/related-canti.js';
import { getUniqueAutori } from '../../lib/related-canti.js';
import { getOgImageForCanto } from '../../lib/og-image.js';
import type { CantoDetail, EventoForCanto } from '../../lib/api/types.js';
import type { RelatedCanto } from '../../lib/related-canti.js';

export async function getStaticPaths() {
  const [allCanti, eventiMap] = await Promise.all([
    getAllCantiDetail(),
    getEventiForCantoMap(),
  ]);

  return allCanti.map((canto) => ({
    params: { slug: canto.slug },
    props: {
      canto,
      eventi: eventiMap.get(canto.id) ?? [],
      relatedCanti: buildRelatedForCanto(canto, allCanti),
    },
  }));
}

const { canto, eventi, relatedCanti } = Astro.props as {
  canto: CantoDetail;
  eventi: EventoForCanto[];
  relatedCanti: RelatedCanto[];
};

const autoriUnici = getUniqueAutori(canto);
const primoAutore = autoriUnici[0] ? await getAutore(autoriUnici[0].slug) : null;
const ogImage = await getOgImageForCanto(canto, primoAutore?.immagine);
---
<CantoDetailView canto={canto} eventi={eventi} relatedCanti={relatedCanti} ogImage={ogImage} />
