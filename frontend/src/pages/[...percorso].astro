---
import PaginaDetailView from '../components/detail/PaginaDetailView.astro';
import { getAllPagineDetail } from '../lib/api/index.js';
import type { PaginaDetail } from '../lib/api/types.js';
import { buildCanonical } from '../lib/seo.js';
import { getOgImageForPagina } from '../lib/og-image.js';

export async function getStaticPaths() {
  const allPagine = await getAllPagineDetail();
  return allPagine.map((pagina) => ({
    params: { percorso: pagina.percorso },
    props: { pagina },
  }));
}

const { pagina } = Astro.props as { pagina: PaginaDetail };
const ogImage = (await getOgImageForPagina(pagina)) ?? undefined;
const canonical = buildCanonical(Astro);
---
<PaginaDetailView pagina={pagina} canonical={canonical} ogImage={ogImage} />
