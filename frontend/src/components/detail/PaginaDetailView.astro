---
// Markup della pagina estratto da pages/[...percorso].astro perché sia
// riusabile anche dalla rotta di anteprima SSR (preview/[uuid].astro).
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../ui/Breadcrumb.astro';
import HeaderWatermark from '../ui/HeaderWatermark.astro';
import ShareModal from '../ui/ShareModal.astro';
import Icon from '../base/Icon.astro';
import ParagraphRenderer from '../paragraphs/ParagraphRenderer.astro';
import type { PaginaDetail } from '../../lib/api/types.js';
import { buildWebPageSchema, buildBreadcrumbSchema } from '../../lib/schema.js';
import { stripHtml } from '../../lib/seo.js';

interface Props {
  pagina: PaginaDetail;
  canonical: string;
  ogImage?: string;
}

const { pagina, canonical, ogImage } = Astro.props;

const description = pagina.descrizioneHeader ? stripHtml(pagina.descrizioneHeader) : '';

const siteUrl = Astro.site?.href?.replace(/\/$/, '') || 'https://www.ildeposito.org';
const jsonLd = [
  buildWebPageSchema(pagina.titolo, description, canonical),
  buildBreadcrumbSchema([
    { name: 'Home', url: siteUrl },
    { name: pagina.titolo },
  ]),
];
---
<BaseLayout
  title={pagina.titolo}
  description={description}
  pagefindType="pagine"
  jsonLd={jsonLd}
  ogImage={ogImage}
  ogImageAlt={ogImage ? `Immagine per ${pagina.titolo}` : undefined}
>

  <header class="relative overflow-hidden bg-base-200 border-b-2 border-secondary">
    <HeaderWatermark />
    <div class="relative z-10 max-w-6xl mx-auto px-4 py-6 flex flex-col gap-2">
      <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: pagina.titolo }]} />
      <h1 class="font-serif font-bold text-2xl md:text-3xl text-base-content">{pagina.titolo}</h1>
      {pagina.descrizioneHeader && (
        <div class="rich-text text-base text-base-content/70" set:html={pagina.descrizioneHeader} />
      )}
      <div class="flex items-center gap-4 text-base text-base-content mt-1">
        <share-button data-title={pagina.titolo} class="contents">
          <button type="button" class="inline-flex items-center gap-1 cursor-pointer" aria-label="Condividi questa pagina">
            <Icon name="share-network" />
            Condividi
          </button>
          <ShareModal pageType="pagina" />
        </share-button>
      </div>
    </div>
  </header>

  <script>
    import '../../scripts/share-button.js';
  </script>

  <div class="max-w-6xl mx-auto px-4" data-pagefind-body>
    <span class="sr-only" data-pagefind-weight="10">{pagina.titolo}</span>
    <span class="sr-only" data-pagefind-sort="titolo">{pagina.titolo}</span>
    {pagina.paragraphs.map((paragraph) => (
      <ParagraphRenderer paragraph={paragraph} />
    ))}
  </div>

</BaseLayout>
