import arrowsClockwise from '@phosphor-icons/core/assets/regular/arrows-clockwise.svg?raw';
import eye from '@phosphor-icons/core/assets/regular/eye.svg?raw';
import eyeSlash from '@phosphor-icons/core/assets/regular/eye-slash.svg?raw';
import minus from '@phosphor-icons/core/assets/regular/minus.svg?raw';
import monitor from '@phosphor-icons/core/assets/regular/monitor.svg?raw';
import moon from '@phosphor-icons/core/assets/regular/moon.svg?raw';
import plus from '@phosphor-icons/core/assets/regular/plus.svg?raw';
import pushPin from '@phosphor-icons/core/assets/regular/push-pin.svg?raw';
import pushPinSlash from '@phosphor-icons/core/assets/regular/push-pin-slash.svg?raw';
import scroll from '@phosphor-icons/core/assets/regular/scroll.svg?raw';
import sun from '@phosphor-icons/core/assets/regular/sun.svg?raw';
import textAa from '@phosphor-icons/core/assets/regular/text-aa.svg?raw';
import eyeFill from '@phosphor-icons/core/assets/fill/eye-fill.svg?raw';
import eyeSlashFill from '@phosphor-icons/core/assets/fill/eye-slash-fill.svg?raw';
import gearFill from '@phosphor-icons/core/assets/fill/gear-fill.svg?raw';
import moonFill from '@phosphor-icons/core/assets/fill/moon-fill.svg?raw';
import pushPinFill from '@phosphor-icons/core/assets/fill/push-pin-fill.svg?raw';
import pushPinSlashFill from '@phosphor-icons/core/assets/fill/push-pin-slash-fill.svg?raw';
import sunFill from '@phosphor-icons/core/assets/fill/sun-fill.svg?raw';

import facebookLogoFill from '@phosphor-icons/core/assets/fill/facebook-logo-fill.svg?raw';
import youtubeLogo from '@phosphor-icons/core/assets/fill/youtube-logo-fill.svg?raw';
import githubLogoFill from '@phosphor-icons/core/assets/fill/github-logo-fill.svg?raw';
import pencilSimple from '@phosphor-icons/core/assets/regular/pencil-simple.svg?raw';
import warningCircle from '@phosphor-icons/core/assets/regular/warning-circle.svg?raw';
import paperPlaneTilt from '@phosphor-icons/core/assets/regular/paper-plane-tilt.svg?raw';
import checkCircle from '@phosphor-icons/core/assets/regular/check-circle.svg?raw';

const icons: Record<string, string> = {
  'arrow-down': arrowDown,
  'arrow-left': arrowLeft,
  'arrow-right': arrowRight,
  'calendar-blank': calendarBlank,
  'calendar-star': calendarStar,
  'caret-down': caretDown,
  'caret-right': caretRight,
  'check': check,
  'copy': copy,
  'envelope': envelope,
  'facebook-logo': facebookLogo,
  'file-pdf': filePdf,
  'funnel': funnel,
  'funnel-x': funnelX,
  'guitar': guitar,
  'headphones': headphones,
  'house': house,
  'image-broken': imageBroken,
  'list': list,
  'magnifying-glass': magnifyingGlass,
  'map-pin': mapPin,
  'music-notes': musicNotes,
  'pause': pauseFill,
  'play': play,
  'play-fill': playFill,
  'share-network': shareNetwork,
  'telegram-logo': telegramLogo,
  'user': user,
  'whatsapp-logo': whatsappLogo,
  'x': x,
  'x-logo': xLogo,
  'hand-fist': handFist,
  'quotes': quotes,
  'tag': tag,
  'users-three': usersThree,
  'books': books,
  'book-open': bookOpen,
  'arrows-clockwise': arrowsClockwise,
  'eye': eye,
  'eye-slash': eyeSlash,
  'minus': minus,
  'monitor': monitor,
  'moon': moon,
  'plus': plus,
  'push-pin': pushPin,
  'push-pin-slash': pushPinSlash,
  'scroll': scroll,
  'sun': sun,
  'text-aa': textAa,
  'eye-fill': eyeFill,
  'eye-slash-fill': eyeSlashFill,
  'gear-fill': gearFill,
  'moon-fill': moonFill,
  'push-pin-fill': pushPinFill,
  'push-pin-slash-fill': pushPinSlashFill,
  'sun-fill': sunFill,
  'facebook-logo-fill': facebookLogoFill,
  'youtube-logo-fill': youtubeLogo,
  'github-logo-fill': githubLogoFill,
  'pencil-simple': pencilSimple,
  'warning-circle': warningCircle,
  'paper-plane-tilt': paperPlaneTilt,
  'check-circle': checkCircle,
};

interface Props {
  name: string;
  class?: string;
  label?: string;
}

const { name, class: className, label } = Astro.props;
const svg = icons[name] ?? '';
---
{label ? (
  <span role="img" aria-label={label} class:list={["inline-flex items-center justify-center shrink-0 [&>svg]:w-[1em] [&>svg]:h-[1em]", className]} set:html={svg} />
) : (
  <span aria-hidden="true" class:list={["inline-flex items-center justify-center shrink-0 [&>svg]:w-[1em] [&>svg]:h-[1em]", className]} set:html={svg} />
)}
