---
import { Image } from 'astro:assets';
import { getWatermarkImageUrl } from '../../lib/api/index.js';

const watermarkUrl = await getWatermarkImageUrl();
---

{watermarkUrl && (
  <Image
    src={watermarkUrl}
    alt=""
    width={1200}
    height={400}
    widths={[480, 768, 1024, 1200]}
    sizes="100vw"
    formats={['avif', 'webp']}
    quality={60}
    loading="eager"
    fetchpriority="high"
    decoding="async"
    class="absolute inset-0 w-full h-full object-cover object-center opacity-10 grayscale pointer-events-none select-none"
  />
)}
