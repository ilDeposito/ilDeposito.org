### Docker4Drupal local defaults. Copy to backend/.env before running locally.
### This file intentionally contains no environment credentials.

PROJECT_NAME=ildeposito
PROJECT_BASE_URL=localhost

DB_NAME=drupal
DB_USER=drupal
DB_HOST=mariadb
DB_PORT=3306
DB_DRIVER=mysql

MARIADB_TAG=11.8-3.35.3
DRUPAL_CMS_TAG=2-1.6.4
DRUPAL_TAG=11-4.100.6
PHP_TAG=8.5-4.82.3
NGINX_TAG=1.31-5.48.5
NGINX_VHOST_PRESET=drupal11
SOLR_TAG=9-5.4.1
OPENSEARCH_TAG=2
# Required only when OpenSearch is enabled locally. Use a unique local value.
OPENSEARCH_ADMIN_PASSWORD=CHANGE_ME_LOCAL_ONLY
VALKEY_TAG=9.0-1.6.6
REDIS_TAG=8.6-5.3.6
NODE_TAG=24-dev-1.70.0
VINYL_TAG=8.0-5.2.4
POSTGRES_TAG=18-1.43.0

ADMINER_TAG=5-5.0.6
APACHE_TAG=2.4-4.18.1
MEMCACHED_TAG=1-2.23.4
OPENSMTPD_TAG=7-1.29.3
RSYSLOG_TAG=latest
SELENIUM_CHROME_TAG=3.141
WEBGRIND_TAG=1-1.49.3
XHPROF_TAG=3.27.3
ZOOKEEPER_TAG=3
